# Copie este arquivo para ".env" e preencha os valores antes de subir o docker-compose.
# Esta aplicação roda na infraestrutura compartilhada Juno (juno-network),
# veja DEPLOY.md para o passo a passo completo.

# Nome usado para nomear o container e a imagem (${APP_NAME}-app)
APP_NAME=chess3d

# Porta interna do servidor Next.js + relay de WebSocket (server.js).
# Não precisa ser publicada no host: o Nginx compartilhado acessa o
# container pelo nome, dentro da juno-network.
PORT=3000
